.DS_Store

# Локальное состояние Supabase CLI
supabase/.temp/

# Растровые ассеты дампа лежат в Supabase Storage (бакет portfolio),
# ссылки в HTML переписаны на публичные URL. SVG остаётся в репозитории:
# Supabase отдаёт SVG и HTML как text/plain, поэтому их нельзя хостить там.
shh-creative/images/*.png
shh-creative/images/*.jpg
shh-creative/images/*.gif

# _inbox — личная папка-приёмник; в git только README и шаблон,
# сами дропнутые файлы (проекты, медиа) не коммитятся.
_inbox/*
!_inbox/README.md
!_inbox/_template
!_inbox/_template/**
