.DS_Store

# Локальное состояние Supabase CLI
supabase/.temp/

# Растровые ассеты дампа лежат в Supabase Storage (бакет portfolio),
# ссылки в HTML переписаны на публичные URL. SVG остаётся в репозитории:
# Supabase отдаёт SVG и HTML как text/plain, поэтому их нельзя хостить там.
shh-creative/images/*.png
shh-creative/images/*.jpg
shh-creative/images/*.gif
shh-creative/images/*.webp

# _inbox — папка-приёмник. Структура папок и метаданные (project.md,
# README, .gitkeep) хранятся в git; сами дропнутые файлы — медиа,
# экспорты страниц, архивы — не коммитятся (их я обрабатываю и удаляю).
_inbox/**/*.png
_inbox/**/*.jpg
_inbox/**/*.jpeg
_inbox/**/*.gif
_inbox/**/*.svg
_inbox/**/*.webp
_inbox/**/*.mp4
_inbox/**/*.mov
_inbox/**/*.webm
_inbox/**/*.json
_inbox/**/*.zip
_inbox/**/*.pdf
_inbox/**/*.ai
_inbox/**/*.psd
_inbox/**/*.fig
_inbox/**/page.html
