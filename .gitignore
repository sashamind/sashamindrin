.DS_Store

# Локальное состояние Supabase CLI
supabase/.temp/

# Медиа кейсов (shh-creative/images и shh-creative/media) лежит прямо в
# репозитории и раздаётся с GitHub Pages — Supabase больше не используется.
# Неиспользуемые оригиналы вынесены за пределы репозитория, в ../_unused-assets.

# _inbox — папка-приёмник. Структура папок и метаданные (project.md,
# README, .gitkeep) хранятся в git; сами дропнутые файлы — медиа,
# экспорты страниц, архивы — не коммитятся (их я обрабатываю и удаляю).
_inbox/**/*.png
_inbox/**/*.jpg
_inbox/**/*.jpeg
_inbox/**/*.gif
_inbox/**/*.svg
_inbox/**/*.webp
_inbox/**/*.mp4
_inbox/**/*.mov
_inbox/**/*.webm
_inbox/**/*.json
_inbox/**/*.zip
_inbox/**/*.pdf
_inbox/**/*.ai
_inbox/**/*.psd
_inbox/**/*.fig
_inbox/**/page.html
